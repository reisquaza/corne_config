#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <36 37 38 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };
    };

    combos {
        compatible = "zmk,combos";

        return {
            bindings = <&kp RETURN>;
            key-positions = <19 20>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
        };

        ctrl+shift {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <25 26>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <15 16>;
        };

        ctrl+backspace {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <27 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&trans    &kp Q  &kp W  &kp E             &kp R     &kp T        &kp Y           &kp U  &kp I         &kp O    &kp P     &trans
&HMR 3 3  &kp A  &kp S  &kp D             &kp F     &kp G        &kp H           &kp J  &kp K         &kp L    &kp SEMI  &to 1
&trans    &kp Z  &kp X  &kp C             &kp V     &kp B        &kp N           &kp M  &kp COMMA     &kp DOT  &kp FSLH  &trans
                        &kp LEFT_CONTROL  &HMR 2 2  &kp SPACE    &kp LEFT_SHIFT  &mo 4  &kp LEFT_ALT
            >;
        };

        number_layer {
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &kp ASTERISK  &kp N7  &kp N8  &kp N9  &kp FSLH     &trans
&trans  &kp F4  &kp F3   &kp F2   &kp F1   &trans    &kp PLUS      &kp N4  &kp N5  &kp N6  &kp MINUS    &to 0
&trans  &kp F8  &kp F7   &kp F6   &kp F5   &trans    &kp N0        &kp N1  &kp N2  &kp N3  &kp PERCENT  &trans
                         &trans   &trans   &trans    &trans        &trans  &trans
            >;
        };

        symbol_layer {
            bindings = <
&trans  &kp GRAVE  &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp UNDER        &kp CARET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &kp PIPE           &trans
&trans  &kp EXCL   &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND    &kp HASH   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES  &to 0
&trans  &kp TILDE  &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT      &kp AT     &kp COLON             &kp COMMA              &kp DOT        &kp APOSTROPHE     &trans
                                  &trans            &to 0              &trans           &trans     &trans                &trans
            >;
        };

        navigation_layer {
            bindings = <
&none  &none  &none           &none           &none         &none              &none           &none           &none         &none            &none  &none
&to 0  &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none  &none
&none  &none  &none           &none           &none         &none              &none           &none           &none         &none            &none  &none
                              &trans          &trans        &trans             &trans          &trans          &trans
            >;
        };

        function_layer {
            bindings = <
&trans  &kp ESC  &kp CAPSLOCK  &trans      &kp PRINTSCREEN  &kp PG_UP        &kp HOME  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans  &kp TAB  &kp K_CUT     &kp K_COPY  &kp K_PASTE      &kp PAGE_DOWN    &kp END   &kp F5  &kp F6   &kp F7   &kp F8   &trans
&trans  &trans   &kp INSERT    &kp K_UNDO  &kp K_REDO       &kp DEL          &trans    &kp F1  &kp F2   &kp F3   &kp F4   &trans
                               &trans      &trans           &trans           &trans    &trans  &trans
            >;
        };
    };
};
